{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Acceptance Criteria Schema",
  "description": "验收标准契约校验规则",
  "type": "object",
  "required": ["criteria"],
  "properties": {
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC-\\d+$" },
          "title": { "type": "string" },
          "description": { "type": "string", "minLength": 1 },
          "testType": { "type": "string", "enum": ["ui", "api", "integration"] },
          "given": { "type": "string" },
          "when": { "type": "string" },
          "then": { "type": "string" },
          "figmaNodeId": { "type": "string" },
          "interfaceRef": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
