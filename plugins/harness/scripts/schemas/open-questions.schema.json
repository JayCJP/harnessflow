{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Open Questions Schema",
  "description": "待确认项契约校验规则。放行判定只读 confirmation 字段（约定由 resolve-question.js 在用户确认后写入，AI 不得自行填写）；resolution/resolutionSource 是给用户的建议稿；resolved 字段已废弃（存量兼容保留，门控不读）。",
  "type": "object",
  "required": ["questions"],
  "properties": {
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question"],
        "properties": {
          "id": { "type": "string", "pattern": "^Q-\\d+$" },
          "question": {
            "type": "string",
            "minLength": 1,
            "description": "问题措辞须让用户答「采纳/yes」直接等价于采纳本条的 resolution 建议稿 —— 写成「是否采纳 <建议稿要点>？」而非中性提问；相互依赖的项在 resolution 中标注「若 Q1 选 A，则本项建议 B」。"
          },
          "resolved": { "type": "boolean" },
          "owner": { "type": "string" },
          "blocking": { "type": "boolean" },
          "source": { "type": "string" },
          "resolution": { "type": "string" },
          "resolutionSource": {
            "type": "string",
            "enum": ["requirement-doc", "prototype", "code-evidence", "inference"]
          },
          "confirmation": {
            "type": "object",
            "required": ["answer"],
            "properties": {
              "answer": { "type": "string", "minLength": 1 },
              "confirmedVia": { "type": "string", "enum": ["verbatim", "accept"] },
              "confirmedAt": { "type": "string" },
              "history": { "type": "array" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
