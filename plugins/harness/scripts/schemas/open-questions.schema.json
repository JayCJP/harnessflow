{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Open Questions Schema",
  "description": "待确认项契约校验规则。放行判定只读 confirmation 字段（约定由 resolve-question.js 在用户确认后写入，AI 不得自行填写）；落账前置条件是 assessment.verdict=final（答复语义判定，由需求分析师在用户答复后写入）；resolution/resolutionSource 是给用户的建议稿；resolved 字段已废弃（存量兼容保留，门控不读）。",
  "type": "object",
  "required": ["questions"],
  "properties": {
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question"],
        "properties": {
          "id": { "type": "string", "pattern": "^Q-\\d+$" },
          "question": {
            "type": "string",
            "minLength": 1,
            "description": "问题须清晰陈述需用户拍板的事并给出建议稿；用户答复的语义（终局/带新分支）由需求分析师在答复后判定，不要求是/否式提问。相互依赖的项在 resolution 中标注「若 Q1 选 A，则本项建议 B」。"
          },
          "resolved": { "type": "boolean" },
          "owner": { "type": "string" },
          "blocking": { "type": "boolean" },
          "source": { "type": "string" },
          "resolution": { "type": "string" },
          "resolutionSource": {
            "type": "string",
            "enum": ["requirement-doc", "prototype", "code-evidence", "inference"]
          },
          "assessment": {
            "type": "object",
            "description": "答复语义判定结论（需求分析师在用户答复后写入；resolve-question.js 落账前校验 verdict=final 且 --answer 与 rawAnswer 逐字一致）。",
            "required": ["verdict", "rawAnswer"],
            "properties": {
              "verdict": { "type": "string", "enum": ["final", "not_answered"] },
              "rawAnswer": {
                "type": "string",
                "minLength": 1,
                "description": "用户答复原话逐字摘录（禁止改写）——落账与审计的原话保真锚点。"
              },
              "decisionExtract": {
                "type": "string",
                "description": "裁决要点摘录（人读，供审计回放比对）。"
              },
              "newQuestionIds": {
                "type": "array",
                "items": { "type": "string" },
                "description": "本答复带出的新问题（已按扁平规则追加为顶层 Q-编号+1 项）的 id 列表。"
              }
            },
            "additionalProperties": false
          },
          "confirmation": {
            "type": "object",
            "required": ["answer"],
            "properties": {
              "answer": { "type": "string", "minLength": 1 },
              "confirmedVia": { "type": "string", "enum": ["verbatim", "accept"] },
              "confirmedAt": { "type": "string" },
              "history": { "type": "array" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
