{
  "name": "harness",
  "version": "2.3.2",
  "description": "Harness Engineering 端到端工作流 — 需求分析 → 任务规划 → 代码开发 → 代码审查 → 知识库更新 → Git 提交 + MR 全流程自动化（云端部署可选）",
  "author": {
    "name": "Harness Team"
  },
  "license": "MIT",
  "defaultEnabled": true,

  "agents": "./agents",
  "skills": "./skills",
  "hooks": "hooks/hooks.json",
  "outputStyles": "output-styles",

  "keywords": ["workflow", "cicd", "bug-fix", "code-review", "testing", "deployment", "phase-management"],

  "userConfig": {
    "workspaceRoot": {
      "type": "string",
      "label": "默认工作区根目录",
      "default": "D:/workfile"
    }
  }
}
